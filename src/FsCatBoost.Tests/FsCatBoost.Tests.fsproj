<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TestHelpers.fs" />
        <Compile Include="ApiTests.fs" />
        <Compile Include="CatBoostCatBoostNetTests.fs" />
        <Compile Include="MireclCatBoostTests.fs" />
        <Compile Include="CatBoostTutorialsTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Deedle" Version="8.1.0" />
        <PackageReference Include="Faqt" Version="6.0.0" />
        <PackageReference Include="FSharp.Stats" Version="0.6.0" />
        <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="example\classifier\classifier.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="example\metadata\metadata.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="example\multiclassification\multiclassification.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="example\ranker\ranker.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="example\regressor\regressor.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="example\survival\survival.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="example\titanic\titanic.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="example\uncertainty\uncertainty.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="testbed\boston\boston_housing_model.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="testbed\boston\housing.data" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="testbed\iris\iris.data" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="testbed\iris\iris_model.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="testbed\mushrooms\mushrooms.csv" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="testbed\mushrooms\mushroom_model.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="tutorials\adult\adult.cbm" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="tutorials\titanic\train.csv" />
      <Content Include="tutorials\titanic\test.csv" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FsCatBoost\FsCatBoost.fsproj" />
    </ItemGroup>

</Project>
