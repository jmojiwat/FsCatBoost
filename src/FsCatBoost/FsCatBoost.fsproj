<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Interop.fs" />
        <Compile Include="Api.fs" />
        <Compile Include="Parameters.fs" />
    </ItemGroup>

    <!--
      CatBoost model applier libraries, one per RID. They are not committed (runtimes/ is gitignored):
      DownloadCatBoostNative fetches them from the CatBoost GitHub release on first build and checks
      each against its SHA-256. To upgrade CatBoost, change CatBoostVersion and the four Sha256 values.
    -->
    <PropertyGroup>
        <CatBoostVersion>1.2.10</CatBoostVersion>
        <CatBoostReleaseUrl>https://github.com/catboost/catboost/releases/download/v$(CatBoostVersion)</CatBoostReleaseUrl>
    </PropertyGroup>

    <ItemGroup>
        <CatBoostNative Include="runtimes\win-x64\native\catboostmodel.dll"
                        Rid="win-x64"
                        Asset="catboostmodel-windows-x86_64-$(CatBoostVersion).dll"
                        Sha256="668d8867940a0832accaad6004e249f11ecc48eb63eb1d65551cfdd37c1939ad" />
        <CatBoostNative Include="runtimes\linux-x64\native\libcatboostmodel.so"
                        Rid="linux-x64"
                        Asset="libcatboostmodel-linux-x86_64-$(CatBoostVersion).so"
                        Sha256="de32f8e147ee8f969599a00b7145e8561b943e916b0132b811037f8f71952a0e" />
        <CatBoostNative Include="runtimes\linux-arm64\native\libcatboostmodel.so"
                        Rid="linux-arm64"
                        Asset="libcatboostmodel-linux-aarch64-$(CatBoostVersion).so"
                        Sha256="d1b5d12f57ef72fd43505d9fbc1ea30d93d54ef0f305484c6bbfde8642e99a5b" />
        <CatBoostNative Include="runtimes\osx\native\libcatboostmodel.dylib"
                        Rid="osx"
                        Asset="libcatboostmodel-darwin-universal2-$(CatBoostVersion).dylib"
                        Sha256="c31067d8df69e0be3dd353a06853d64f2e74bab1097512fc2d0db76add75514e" />
    </ItemGroup>

    <!-- Packed under runtimes/<rid>/native/ so NuGet consumers get the right one via deps.json. -->
    <ItemGroup>
        <None Include="@(CatBoostNative)" Pack="true" PackagePath="runtimes\%(Rid)\native" />
    </ItemGroup>

    <!--
      Project references (e.g. the test project) don't get deps.json entries for runtimes/ assets,
      so also copy the library for the current platform into the output root, where the default
      DllImport probing finds it. Not packed.
    -->
    <PropertyGroup>
        <CatBoostNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</CatBoostNativeRid>
        <CatBoostNativeRid Condition="'$(CatBoostNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</CatBoostNativeRid>
        <CatBoostNativeRid Condition="$(CatBoostNativeRid.StartsWith('osx'))">osx</CatBoostNativeRid>
    </PropertyGroup>

    <ItemGroup>
        <None Include="@(CatBoostNative->WithMetadataValue('Rid', '$(CatBoostNativeRid)'))"
              Link="%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              Pack="false" />
    </ItemGroup>

    <!--
      Runs once per CatBoostNative item (target batching via Outputs). A verified file gets a
      <file>.sha256 stamp, so later builds compare the stamp instead of re-hashing; a version/hash
      change no longer matches the stamp and re-downloads automatically.
    -->
    <Target Name="DownloadCatBoostNative" BeforeTargets="BeforeBuild" Outputs="%(CatBoostNative.Identity)">
        <PropertyGroup>
            <CatBoostNativeFile>%(CatBoostNative.FullPath)</CatBoostNativeFile>
            <CatBoostNativeStamp>%(CatBoostNative.FullPath).sha256</CatBoostNativeStamp>
            <CatBoostNativeAsset>%(CatBoostNative.Asset)</CatBoostNativeAsset>
            <CatBoostNativeExpectedHash>%(CatBoostNative.Sha256)</CatBoostNativeExpectedHash>
            <CatBoostNativeDownloadFolder>$(BaseIntermediateOutputPath)catboost-native\$(CatBoostVersion)</CatBoostNativeDownloadFolder>
            <CatBoostNativeHash></CatBoostNativeHash>
            <CatBoostNativeDownloadHash></CatBoostNativeDownloadHash>
        </PropertyGroup>

        <ReadLinesFromFile Condition="Exists('$(CatBoostNativeFile)') And Exists('$(CatBoostNativeStamp)')" File="$(CatBoostNativeStamp)">
            <Output TaskParameter="Lines" PropertyName="CatBoostNativeHash" />
        </ReadLinesFromFile>

        <!-- No stamp (or a stale one): hash the existing file once rather than re-downloading it. -->
        <GetFileHash Condition="Exists('$(CatBoostNativeFile)') And '$(CatBoostNativeHash)' != '$(CatBoostNativeExpectedHash)'" Files="$(CatBoostNativeFile)" Algorithm="SHA256">
            <Output TaskParameter="Hash" PropertyName="CatBoostNativeHash" />
        </GetFileHash>

        <PropertyGroup>
            <CatBoostNativeNeedsDownload Condition="'$(CatBoostNativeHash)' != '$(CatBoostNativeExpectedHash)'">true</CatBoostNativeNeedsDownload>
            <CatBoostNativeNeedsDownload Condition="'$(CatBoostNativeHash)' == '$(CatBoostNativeExpectedHash)'">false</CatBoostNativeNeedsDownload>
        </PropertyGroup>

        <Message Condition="$(CatBoostNativeNeedsDownload)" Importance="high"
                 Text="Downloading $(CatBoostReleaseUrl)/$(CatBoostNativeAsset)" />

        <DownloadFile Condition="$(CatBoostNativeNeedsDownload)"
                      SourceUrl="$(CatBoostReleaseUrl)/$(CatBoostNativeAsset)"
                      DestinationFolder="$(CatBoostNativeDownloadFolder)"
                      DestinationFileName="$(CatBoostNativeAsset)"
                      Retries="3">
            <Output TaskParameter="DownloadedFile" ItemName="CatBoostNativeDownloaded" />
        </DownloadFile>

        <GetFileHash Condition="$(CatBoostNativeNeedsDownload)" Files="@(CatBoostNativeDownloaded)" Algorithm="SHA256">
            <Output TaskParameter="Hash" PropertyName="CatBoostNativeDownloadHash" />
        </GetFileHash>

        <Delete Condition="$(CatBoostNativeNeedsDownload) And '$(CatBoostNativeDownloadHash)' != '$(CatBoostNativeExpectedHash)'"
                Files="@(CatBoostNativeDownloaded)" />
        <Error Condition="$(CatBoostNativeNeedsDownload) And '$(CatBoostNativeDownloadHash)' != '$(CatBoostNativeExpectedHash)'"
               Text="SHA-256 mismatch for $(CatBoostReleaseUrl)/$(CatBoostNativeAsset): expected $(CatBoostNativeExpectedHash), got $(CatBoostNativeDownloadHash). If you upgraded CatBoost, update the Sha256 values in FsCatBoost.fsproj." />

        <Copy Condition="$(CatBoostNativeNeedsDownload)" SourceFiles="@(CatBoostNativeDownloaded)" DestinationFiles="$(CatBoostNativeFile)" />
        <Delete Condition="$(CatBoostNativeNeedsDownload)" Files="@(CatBoostNativeDownloaded)" />

        <WriteLinesToFile File="$(CatBoostNativeStamp)" Lines="$(CatBoostNativeExpectedHash)" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <CatBoostNativeDownloaded Remove="@(CatBoostNativeDownloaded)" />
        </ItemGroup>
    </Target>

</Project>
